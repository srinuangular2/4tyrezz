{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run install:apps",
  "buildCommand": "npm run build",
  "outputDirectory": "customer/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backgrounds-triangle-attachment-aye.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://backgrounds-triangle-attachment-aye.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dealer",
      "destination": "/d/index.html"
    },
    {
      "source": "/dealer/",
      "destination": "/d/index.html"
    },
    {
      "source": "/dealer/:path*",
      "destination": "/d/index.html"
    },
    {
      "source": "/((?!assets/|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
