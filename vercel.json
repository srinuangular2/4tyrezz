{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix customer && npm install --prefix admin && npm install --prefix dealer",
  "buildCommand": "VITE_API_URL=/api npm run build --prefix customer && VITE_API_URL=/api npm run build --prefix admin && VITE_API_URL=/api npm run build --prefix dealer && rm -rf customer/dist/admin customer/dist/d && cp -R admin/dist customer/dist/admin && cp -R dealer/dist customer/dist/d",
  "outputDirectory": "customer/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lou-honest-cloudy-techniques.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://lou-honest-cloudy-techniques.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dealer",
      "destination": "/d/index.html"
    },
    {
      "source": "/dealer/",
      "destination": "/d/index.html"
    },
    {
      "source": "/dealer/:path*",
      "destination": "/d/index.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
