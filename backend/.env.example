PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/4tyrezz
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:5000
OTP_MODE=development
MOCK_OTP=false
MOCK_GOOGLE=true
# GOOGLE_CLIENT_ID=
# Msg91 — leave AUTH_KEY empty in local to stub; set both to deliver live SMS + WhatsApp
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_WHATSAPP_NUMBER=
# MSG91_WHATSAPP_TEMPLATE=
# MSG91_WHATSAPP_OTP_TEMPLATE=
# Listing moderation — dealer create/update goes to admin approval queue
REQUIRE_LISTING_MODERATION=true
COMPANY_PHONE=7993980559
COMPANY_WHATSAPP=917993980559
COMMISSION_RATE_PERCENT=2.5
FINANCE_DEFAULT_RATE=10.5
FINANCE_DEFAULT_TENURE=60
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_WHATSAPP_NUMBER=
# MSG91_WHATSAPP_TEMPLATE=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Live RC lookup — Way2API (vehicle number only). RapidAPI kept as optional fallback.
RTO_PROVIDER=way2api
RTO_API_TIMEOUT=25000
RTO_ALLOW_DEMO=false
# WAY2API_KEY=
# WAY2API_URL=https://app.way2api.com/api/v1/rc/verify
# RAPIDAPI_KEY=
# RTO_CONSENT_TEXT=I hereby give my consent for Eccentric Labs API to fetch my information
# RAPIDAPI_HOST=rto-vehicle-information-india.p.rapidapi.com
# RTO_API_URL=https://rto-vehicle-information-india.p.rapidapi.com/getVehicleInfo
# Optional Google Places (wizard geocode uses Nominatim if unset)
# GOOGLE_MAPS_API_KEY=
# AI listing copy — OpenAI gpt-4o-mini preferred; Gemini used if OpenAI key is empty
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# VALUATION_API_URL=
# VALUATION_API_KEY=
# VALUATION_API_TIMEOUT=4000
# Dealer KYC verification — sandbox rejects placeholders; set URLs + key for Karza / Surepass / RapidAPI
KYC_PROVIDER=sandbox
# KYC_API_KEY=
# KYC_PAN_API_URL=
# KYC_GST_API_URL=
# KYC_PAN_API_HOST=
# KYC_GST_API_HOST=
