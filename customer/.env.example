# Leave unset to use the Vite dev proxy (see vite.config.js) against localhost:5000.
# Set this to your deployed API URL when building for production.
VITE_API_URL=/api

# Optional absolute origin for media/API in production builds (e.g. https://api.example.com).
# Leave UNSET for local + phone LAN testing so /uploads stays relative and uses the Vite proxy.
# VITE_API_ORIGIN=

# Separate dealer workspace (Option B). Local default is http://localhost:5175
# VITE_DEALER_URL=http://localhost:5175

# Optional: Google OAuth client ID for real "Continue with Google" button
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
