{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://perform-consultancy-arise-excel.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://perform-consultancy-arise-excel.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
